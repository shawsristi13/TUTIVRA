# ============================================================
# TUTIVRA — Environment Variables Template
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ============================================================

# ─── PRIMARY LLM: OpenRouter ────────────────────────────────
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model to use (default: google/gemini-flash-1.5)
# Options: anthropic/claude-3-haiku, openai/gpt-4o-mini, etc.
OPENROUTER_MODEL=google/gemini-flash-1.5

# ─── FALLBACK LLM 1: Google Gemini ──────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model to use (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ─── FALLBACK LLM 2: xAI Grok (optional) ────────────────────
# Get key at: https://console.x.ai/
XAI_API_KEY=
# Model to use (default: grok-beta)
XAI_MODEL=grok-beta

# ─── Fish Audio TTS ─────────────────────────────────────────
# Get key at: https://fish.audio/
FISH_AUDIO_API_KEY=
# Optional: reference voice ID from Fish Audio library
FISH_AUDIO_VOICE_ID=

# ─── D-ID Avatar Video ──────────────────────────────────────
# Get key at: https://www.d-id.com/
DID_API_KEY=
# Optional: override default D-ID presenter
DID_PRESENTER_ID=amy-Aq6OmGZnMt

# ─── App Config ─────────────────────────────────────────────
API_PORT=8000
RAG_STORAGE_DIR=rag_storage
RAG_UPLOADS_DIR=rag_uploads
TUTIVRA_DB_PATH=tutivra.db
